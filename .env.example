# Credenciais do Telegram (Obtenha em https://my.telegram.org)
TELEGRAM_API_ID=YOUR_API_ID
TELEGRAM_API_HASH=YOUR_API_HASH

# StringSession do Telegram, gerada com generate_session.py.
# Só necessária em produção/servidor (sem ela, roda localmente usando o arquivo minha_sessao.session).
TELEGRAM_STRING_SESSION=

# Nome (deve bater com um PESSOAxx_NAME) usado como padrão nos comandos /kw e para notificações locais.
OWNER_NAME=NAME

# Bot próprio (criado no @BotFather) usado só pra te notificar — assim a mensagem chega como
# recebida de verdade (com push), em vez de "enviada por você" em Mensagens Salvas.
# Passo a passo: crie o bot no @BotFather, mande uma mensagem pra ele, e rode get_chat_id.py.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_CHAT_ID=

# Credenciais do CallMeBot (Obtenha em https://www.callmebot.com/blog/free-api-whatsapp-messages/)
PESSOA01_NAME=NAME
PESSOA01_PHONE_NUMBER=5511999999999
PESSOA01_WHATSAPP_API_ID=1111111

# Palavras-chave para monitorar (só usadas na primeira execução — depois disso o estado
# fica em data/keywords.json e pode ser editado com /kw add|remove, mandando mensagem
# pra "Mensagens Salvas" no próprio Telegram)
# OBS: Para maior precisão, use o máximo de maneiras possíveis para essa palavra chave:
# Ex: water cooler, watercooler, water-cooler
PESSOA01_KEYWORDS=keyword1,keyword2,keyword3
